# ============================================================
# submission_llm_core 环境变量模板
# ------------------------------------------------------------
# 使用方法：复制本文件为 .env，填入你自己的 API key。
#   cp .env.example .env
# 本代码包只需要 LLM 相关配置，不依赖任何数据库 / 对象存储密钥。
# 三个 provider 任选其一填写即可（vivo / ecnu / glm）。
# ============================================================

# ---- 选择默认 provider：vivo | remote_api(ecnu) | glm | ollama ----
LLM_PROVIDER=vivo

# ---- vivo AIGC（推荐，复赛主力 provider）----
VIVO_AIGC_BASE_URL=https://api-ai.vivo.com.cn/v1/chat/completions
VIVO_AIGC_API_KEY=your_vivo_api_key_here
VIVO_AIGC_APP_ID=your_vivo_app_id_here
VIVO_AIGC_MODEL=Volc-DeepSeek-V3.2

# ---- ECNU（华东师大校内 API，remote_api provider）----
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
ECNU_API_KEY=your_ecnu_api_key_here
ECNU_MODEL_NAME=ecnu-max

# ---- 智谱 GLM / BigModel（benchmark_fulltext 全文直提使用）----
BIGMODEL_API_KEY=your_bigmodel_api_key_here
GLM_MODEL_NAME=glm-4.5-air
