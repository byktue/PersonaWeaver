# ============================================================
# PersonaWeaver 后端配置模板
# 用法：复制本文件为 .env，填入你自己的密钥。
#   copy .env.example .env
# 三个 LLM provider 任选其一填写（vivo 推荐）。
# 完整业务功能（书籍提取/角色卡落库）还需 Supabase / OSS 配置。
# ============================================================

# ---- 默认 provider：vivo | remote_api(ecnu) | glm | ollama ----
LLM_PROVIDER=vivo

# ---- vivo AIGC（推荐主力）----
VIVO_AIGC_BASE_URL=https://api-ai.vivo.com.cn/v1/chat/completions
VIVO_AIGC_API_KEY=你的vivo_api_key
VIVO_AIGC_APP_ID=你的vivo_app_id
VIVO_AIGC_MODEL=Volc-DeepSeek-V3.2

# ---- ECNU（华东师大校内 API）----
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
ECNU_API_KEY=你的ecnu_key
ECNU_MODEL_NAME=ecnu-max

# ---- 智谱 GLM ----
BIGMODEL_API_KEY=你的bigmodel_key
GLM_MODEL_NAME=glm-4.5-air

# ============================================================
# 以下为完整业务功能所需（仅验证服务+大模型可跳过）
# ============================================================
# ---- Supabase（书籍/角色卡/任务落库 + 登录鉴权）----
SUPABASE_DB_URL=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 阿里云 OSS（原文/中间产物存储）----
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
